{
  "name": "mcp-calculator",
  "version": "1.0.0",
  "description": "Educational calculator app demonstrating MCP client-server architecture with TypeScript.",
  "type": "module",
  "main": "dist/client/client-backend.js",
  "scripts": {
    "clean": "rimraf dist public/app.js public/app.js.map",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "tsc -p tsconfig.client.json",
    "build": "npm run clean && npm run build:server && npm run build:client",
    "start:client": "node dist/client/client-backend.js",
    "start:server": "node dist/server/calculator-server.js",
    "dev": "npm run build && npm run start:client"
  },
  "keywords": [
    "mcp",
    "typescript",
    "express",
    "calculator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "openai": "^6.22.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
